# Study Planner - Environment Configuration Example
# Copy this file to .env and fill in your real values
# DO NOT commit .env - it contains sensitive secrets

# ========================================
# Gemini AI Configuration
# ========================================
# Get your free Gemini API key here: https://aistudio.google.com/app/apikey
# Free tier: 60 requests/min, 1500 requests/day
# For production: use a paid API key with billing enabled
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_TOKENS=1024

# ========================================
# MySQL Database Configuration
# ========================================
# For local development:
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=studyplanner
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here

# For Docker Compose deployment:
# MYSQL_HOST=mysql    # (use service name in docker-compose network)
# MYSQL_PORT=3306

# ========================================
# Test Database
# ========================================
MYSQL_TEST_HOST=localhost
MYSQL_TEST_PORT=3307
MYSQL_TEST_DATABASE=studyplanner_test
MYSQL_TEST_PASSWORD=your_password_here

# ========================================
# Application Configuration
# ========================================
SERVER_PORT=8080
APP_JWT_SECRET=your_jwt_secret_key_2025
APP_JWT_EXPIRATION=3600000
