
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_TOKENS=2048


# MySQL — utilisé par le serveur Express (server/)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=studyplanner
MYSQL_USER=root
MYSQL_PASSWORD=root


SERVER_PORT=8085
APP_JWT_SECRET=your_jwt_secret_key_2025
APP_JWT_EXPIRATION=3600000

# Seed au démarrage (crée admin/demo si absents)
APP_SEED_ENABLED=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@studyplanner.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_DEMO_USERNAME=demo
SEED_DEMO_EMAIL=demo@studyplanner.local
SEED_DEMO_PASSWORD=Demo123!
